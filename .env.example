# Copy to .env and adjust. Every value has a working local default, so an
# empty .env still starts the service.

# --- service identity ------------------------------------------------------
APP_NAME=dock
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO

# --- authentication --------------------------------------------------------
# Off by default so local dev needs no setup. Turn it on for anything shared:
# the service warns loudly at startup if ENVIRONMENT=production without it.
REQUIRE_API_KEY=false
# Comma-separated, or a JSON list. Generate with: openssl rand -hex 24
API_KEYS=

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- idempotency -----------------------------------------------------------
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_MAX_ENTRIES=10000

# --- request handling ------------------------------------------------------
MAX_BATCH_SIZE=100
# Deadline on time-to-first-byte. Past it the caller gets a 504 problem
# document; the handler thread may keep running, so this protects callers
# rather than the server (see docs/adr/0008).
REQUEST_TIMEOUT_SECONDS=10
SHUTDOWN_GRACE_SECONDS=10

# --- observability ---------------------------------------------------------
# Whether the /metrics route is mounted. Collection always runs — these are
# in-process counters — so this controls exposure, not measurement. Turn it off
# where /metrics would otherwise be reachable from a public ingress.
METRICS_ENDPOINT_ENABLED=true
# console prints spans to stdout (local dev only); otlp ships them to a real
# collector; none disables tracing.
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- model -----------------------------------------------------------------
MODEL_RANDOM_SEED=42
MODEL_CONTAMINATION=0.02
MODEL_TRAINING_SAMPLES=2000
MODEL_N_ESTIMATORS=200
